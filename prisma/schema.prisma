generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  email                  String    @unique
  phone                  String?
  passwordHash           String
  role                   UserRole  @default(PATIENT)
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  sessions               Session[]
}

model Session {
  id           String    @id @default(uuid())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  ipAddress    String
  city         String?
  country      String?
  device       String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([userId])
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  url       String
  isVisible Boolean  @default(true)
}

model Appointment {
  id        String   @id @default(uuid())
  type      String
  name      String
  email     String
  phone     String   @default("")
  reason    String
  format    String
  language  String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  gender    String?
  age       Int?
  condition String?
  status    String   @default("Consultation")
  lastVisit String?  @default("Today (New Request)")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id          String   @id @default(uuid())
  title       String
  category    String
  imageUrl    String
  imageKey    String?
  description String?
  author      String?  @default("Doctor / Wellness Admin")
  aspectRatio String?  @default("landscape")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

model YogaSession {
  id            String   @id @default(uuid())
  title         String
  duration      String   @default("60 mins")
  format        String   @default("offline")
  suitableFor   String   @default("Beginner (All Ages)")
  days          String   @default("[]")
  time          String?
  scheduleItems String?
  description   String
  level         String?  @default("Beginner")
  ageGroup      String?
  instructor    String?
  location      String?
  capacity      Int?
  enrolledCount Int      @default(0)
  price         String?
  priceAmount   String?
  priceUnit     String?
  status        String   @default("active")
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([format])
  @@index([status])
  @@index([createdAt])
}
